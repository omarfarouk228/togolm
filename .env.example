# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=togolm
POSTGRES_USER=togolm
POSTGRES_PASSWORD=change_me

# Gemini API (embeddings + generation V1)
GEMINI_API_KEY=your_gemini_api_key_here
# Chat model used for generation, routing, image understanding, etc. (optional,
# defaults to gemini-2.5-flash — see rag/generation/llm.py)
# GEMINI_MODEL=gemini-2.5-flash
# Automatic fallback model: retried once if GEMINI_MODEL fails (quota
# exhausted, model unavailable, etc.). Optional, defaults to gemini-3-flash-preview.
# GEMINI_FALLBACK_MODEL=gemini-3-flash-preview

# API config
API_SECRET_KEY=change_me_in_production
# Shared with the website (togolm-showcase): lets it issue a new key for an
# e-mail it verified at sign-in (POST /v1/auth/keys/claim). Empty = disabled.
INTERNAL_API_TOKEN=
# Signs admin JWTs; must differ from API_SECRET_KEY (openssl rand -hex 32).
ADMIN_JWT_SECRET=
API_ENV=development
# Comma-separated list of static API keys. Empty accepts any key, but only
# when API_ENV is not production.
API_KEYS=key1,key2,key3
# Free keys per IP per day on POST /v1/auth/register (the website is exempt).
# REGISTER_PER_IP_PER_DAY=5
# Allowed browser origins, comma-separated (empty = all).
# CORS_ORIGINS=https://togolm.com,https://admin.togolm.com

# Celery (async tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Scraping
SCRAPY_CONCURRENT_REQUESTS=4
SCRAPY_DOWNLOAD_DELAY=1.5

# Optional Claude fallback when Gemini is unavailable
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=

# Topic alerts (SMTP)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
# Base URL used in alert confirmation links
# PUBLIC_API_URL=https://api.togolm.com

# Payments (PayGate Global)
PAYGATE_API_KEY=

# Bots
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# BOT_DAILY_LIMIT=30
